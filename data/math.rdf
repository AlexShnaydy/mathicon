	<label xml:lang="en">Existential quantification</label>
	<label xml:lang="symbol">∃</label>
	<comment xml:lang="ru">Существует, найдётся...</comment>
</rdf:Description>

<rdf:Description rdf:about="http://www.ukp.informatik.tu-darmstadt.de/inception/1.0#f44c7bd899924c689bcc54588c4f274e53">
