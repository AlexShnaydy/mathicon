	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<label xml:lang="ru">Квантор единственности</label>
	<label xml:lang="en">Uniqueness quantification</label>
	<label xml:lang="symbol">∃!</label>
	<comment xml:lang="ru">Существует единственный; является единственным...</comment>
</rdf:Description>

<rdf:Description rdf:about="http://www.ukp.informatik.tu-darmstadt.de/inception/1.0#f44c7bd899924c689bcc54588c4f274e54">
